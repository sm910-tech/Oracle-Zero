# Copy this file to .env and fill in real values as you have them.
# The backend runs fine with none of these set: it just stays in demo mode.

# --- Server ---
# Comma-separated list of origins allowed to call this API from a browser.
# The Vite dev server defaults to http://localhost:5173.
CORS_ORIGINS=http://localhost:5173

# --- NVIDIA Nemotron ---
# Get a key from https://build.nvidia.com (NVIDIA API Catalog).
# Leave blank to keep the AI reasoning layer in demo mode: the backend will
# still work, but /simulations/explain will return a clearly-labeled canned
# explanation instead of a real model response.
NVIDIA_API_KEY=
NVIDIA_NEMOTRON_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
NVIDIA_API_BASE_URL=https://integrate.api.nvidia.com/v1
